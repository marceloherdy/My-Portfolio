{
  "datasets": [
    {
      "name": "f92d85f5",
      "displayName": "Pipeline run KPIs",
      "queryLines": [
        "SELECT sum(runs_count) AS total_runs,\n",
        "       sum(failed_count) AS failed_runs,\n",
        "       sum(empty_runs_count) AS empty_runs\n",
        "FROM databricks_course_ws_new.gold.pipeline_run_health\n"
      ]
    },
    {
      "name": "6bfbbd10",
      "displayName": "Average duration by task",
      "queryLines": [
        "SELECT regexp_replace(regexp_replace(task_name, '^gold_', ''), '_daily$', '') AS task_name,\n",
        "       round(sum(avg_duration_sec * runs_count) / sum(runs_count), 1) AS avg_duration_sec\n",
        "FROM databricks_course_ws_new.gold.pipeline_run_health\n",
        "GROUP BY task_name\n",
        "ORDER BY avg_duration_sec DESC\n"
      ]
    },
    {
      "name": "8789da15",
      "displayName": "File processing latency",
      "queryLines": [
        "SELECT CAST(processed_date AS STRING) AS processed_date,\n",
        "       replace(target_table, 'databricks_course_ws_new.', '') AS target_table, files_count,\n",
        "       round(avg_latency_sec, 1) AS avg_latency_sec,\n",
        "       max_latency_sec, failed_files_count\n",
        "FROM databricks_course_ws_new.gold.file_processing_latency\n",
        "ORDER BY processed_date DESC, target_table\n"
      ]
    },
    {
      "name": "fec038e0",
      "displayName": "Quarantine KPIs",
      "queryLines": [
        "WITH q AS (SELECT count(*) AS n FROM databricks_course_ws_new.silver.spotify_events_quarantine),\n",
        "     s AS (SELECT count(*) AS n FROM databricks_course_ws_new.silver.spotify_events)\n",
        "SELECT q.n AS quarantined_records,\n",
        "       s.n AS accepted_records,\n",
        "       round(100 * q.n / (q.n + s.n), 1) AS quarantine_pct\n",
        "FROM q CROSS JOIN s\n"
      ]
    },
    {
      "name": "a3ae7af3",
      "displayName": "Loss and degradation by field",
      "queryLines": [
        "SELECT issue, impact, sum(records_count) AS records_count\n",
        "FROM databricks_course_ws_new.gold.field_quality\n",
        "GROUP BY issue, impact\n",
        "ORDER BY records_count DESC\n"
      ]
    },
    {
      "name": "cd27de5d",
      "displayName": "Quarantine rejection reasons",
      "queryLines": [
        "SELECT category AS rejection_reason, sum(records_count) AS records_count\n",
        "FROM databricks_course_ws_new.gold.data_quality_summary\n",
        "WHERE metric_type = 'REJECTION_REASON'\n",
        "GROUP BY category\n",
        "ORDER BY records_count DESC\n"
      ]
    },
    {
      "name": "cdc3f1b7",
      "displayName": "Timestamp classification",
      "queryLines": [
        "SELECT category AS timestamp_classification, sum(records_count) AS records_count\n",
        "FROM databricks_course_ws_new.gold.data_quality_summary\n",
        "WHERE metric_type = 'TIMESTAMP_CLASSIFICATION'\n",
        "GROUP BY category\n"
      ]
    },
    {
      "name": "24ce3446",
      "displayName": "Business KPI totals",
      "queryLines": [
        "SELECT sum(plays_count) AS total_plays,\n",
        "       max(active_users) AS peak_daily_active_users,\n",
        "       round(sum(total_duration_sec) / 3600, 1) AS hours_listened\n",
        "FROM databricks_course_ws_new.gold.business_kpi_daily\n"
      ]
    },
    {
      "name": "d9f1456f",
      "displayName": "Plays by day",
      "queryLines": [
        "SELECT event_date, plays_count\n",
        "FROM databricks_course_ws_new.gold.business_kpi_daily\n"
      ]
    },
    {
      "name": "68cdc9b6",
      "displayName": "Top 10 tracks",
      "queryLines": [
        "SELECT track_id, sum(plays_count) AS plays_count\n",
        "FROM databricks_course_ws_new.gold.track_popularity_daily\n",
        "GROUP BY track_id\n",
        "ORDER BY plays_count DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "2ddb6411",
      "displayName": "Plays by device",
      "queryLines": [
        "SELECT device_type, sum(plays_count) AS plays_count\n",
        "FROM databricks_course_ws_new.gold.device_usage_daily\n",
        "GROUP BY device_type\n"
      ]
    },
    {
      "name": "dac4d10c",
      "displayName": "Top 10 users",
      "queryLines": [
        "SELECT user_id,\n",
        "       sum(plays_count) AS plays_count,\n",
        "       round(sum(total_duration_sec) / 3600, 1) AS hours_listened\n",
        "FROM databricks_course_ws_new.gold.user_activity_daily\n",
        "GROUP BY user_id\n",
        "ORDER BY plays_count DESC\n",
        "LIMIT 10\n"
      ]
    }
  ],
